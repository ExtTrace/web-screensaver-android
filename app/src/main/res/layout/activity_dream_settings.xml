<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#090A0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Header Banner Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <!-- App Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_header_title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="6dp" />

            <!-- Subtitle Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_header_subtitle"
                android:textSize="13sp"
                android:textColor="#8E8EA0"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Main Configuration Surface Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_background"
            android:layout_marginBottom="24dp">

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_config"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#6366F1"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:layout_marginBottom="16dp" />

            <!-- URL Field Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_url"
                android:textSize="12sp"
                android:textColor="#D0D0E0"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- URL EditText Field -->
            <EditText
                android:id="@+id/editTextUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_url"
                android:textColor="#FFFFFF"
                android:textColorHint="#4B4D66"
                android:textSize="13sp"
                android:padding="14dp"
                android:background="@drawable/input_background"
                android:inputType="textUri"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:layout_marginBottom="14dp" />

            <!-- Hint & Tip Info Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@drawable/tip_background"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="14sp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hint_mode_tip"
                    android:textSize="11sp"
                    android:textColor="#9E9EA0"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Actions Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Save Settings Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_save"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="#6366F1"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Preview in Browser Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreview"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_preview"
                android:textSize="14sp"
                android:textAllCaps="false"
                app:backgroundTint="#161724"
                app:strokeColor="#2C2E45"
                app:strokeWidth="1dp"
                android:textColor="#E0E0FF"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Open System Screensaver Settings Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSystemScreensaver"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_open_system_settings"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#25273C"
                app:strokeWidth="1dp"
                android:textColor="#8E8EA0"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
